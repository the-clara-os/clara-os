  (check '(0 0 0) (list (clara.emma::editor-row editor) (editor-wrong editor) (clara.emma::editor-top editor)))
  (keys editor clara.input:+page-down+ clara.input:+page-down+ clara.input:+end+ " is a line of more than thirty characters")
  (check '(5 44 0 2 15)
         (list (clara.emma::editor-row editor) (clara.emma::editor-column editor) (editor-wrong editor)
               (clara.emma::editor-top editor) (clara.emma::editor-left editor)))
  (keys editor clara.input:+home+)
  (check '(0 0 0) (list (editor-wrong editor) (clara.emma::editor-left editor) (wrong-pixels)))
  (clara.windows:close-window (clara.emma::editor-window editor)))

;; The same keys to the editor and to one that is written here, a few
;; hundred of them as they come: the two have the same text, the cursor at
;; the same place and the same lines in the window, and every cell of the
;; window shows it.
(defstruct ref (lines (list "")) (row 0) (column 0) (cut "") cutting (top 0) (left 0))

(defun ref-line (ref)
  (nth (ref-row ref) (ref-lines ref)))

(defun ref-put (ref &rest lines)       ; in place of the cursor's line
  (setf (ref-lines ref) (append (subseq (ref-lines ref) 0 (ref-row ref)) lines (nthcdr (1+ (ref-row ref)) (ref-lines ref)))))

(defun ref-join (ref)                  ; the cursor's line and the next are one
  (let ((next (nth (1+ (ref-row ref)) (ref-lines ref))))
    (setf (ref-lines ref) (append (subseq (ref-lines ref) 0 (ref-row ref))
                                  (list (concatenate 'string (ref-line ref) next))
                                  (nthcdr (+ 2 (ref-row ref)) (ref-lines ref))))))

(defun ref-insert (ref text)
  (loop for character across text
        do (let ((line (ref-line ref)) (column (ref-column ref)))
             (cond ((char= character #\Newline)
                    (ref-put ref (subseq line 0 column) (subseq line column))
                    (incf (ref-row ref))
                    (setf (ref-column ref) 0))
                   (t
                    (ref-put ref (concatenate 'string (subseq line 0 column) (string character) (subseq line column)))
                    (incf (ref-column ref)))))))

(defun ref-key (ref code rows)
  (let* ((cutting (ref-cutting ref)) (line (ref-line ref)) (row (ref-row ref)) (column (ref-column ref))
         (last (1- (length (ref-lines ref)))))
    (setf (ref-cutting ref) nil)
    (flet ((clamp ()
             (setf (ref-column ref) (min (ref-column ref) (length (ref-line ref))))))
      (cond ((= code 10)
             (let ((indent (or (position #\Space line :test-not #'char= :end column) column)))
               (ref-insert ref (string #\Newline))
               (ref-insert ref (make-string indent :initial-element #\Space))))
            ((= code 8)
             (cond ((plusp column)
                    (ref-put ref (concatenate 'string (subseq line 0 (1- column)) (subseq line column)))
                    (decf (ref-column ref)))
                   ((plusp row)
                    (decf (ref-row ref))
                    (setf (ref-column ref) (length (ref-line ref)))
                    (ref-join ref))))
            ((= code 127)
             (cond ((< column (length line))
                    (ref-put ref (concatenate 'string (subseq line 0 column) (subseq line (1+ column)))))
                   ((< row last) (ref-join ref))))
            ((= code 9) (ref-insert ref (make-string (- 8 (mod column 8)) :initial-element #\Space)))
            ((= code clara.input:+up+) (when (plusp row) (decf (ref-row ref)) (clamp)))
            ((= code clara.input:+down+) (when (< row last) (incf (ref-row ref)) (clamp)))
            ((= code clara.input:+left+)
             (cond ((plusp column) (decf (ref-column ref)))
                   ((plusp row) (decf (ref-row ref)) (setf (ref-column ref) (length (ref-line ref))))))
            ((= code clara.input:+right+)
             (cond ((< column (length line)) (incf (ref-column ref)))
                   ((< row last) (incf (ref-row ref)) (setf (ref-column ref) 0))))
            ((= code clara.input:+home+) (setf (ref-column ref) 0))
            ((= code clara.input:+end+) (setf (ref-column ref) (length line)))
            ((= code clara.input:+page-up+) (dotimes (i (1- rows)) (ref-key ref clara.input:+up+ rows)))
            ((= code clara.input:+page-down+) (dotimes (i (1- rows)) (ref-key ref clara.input:+down+ rows)))
            ((= code 11)
             (let ((taken (cond ((< column (length line)) (ref-put ref (subseq line 0 column)) (subseq line column))
                                ((< row last) (ref-join ref) (string #\Newline)))))
               (when taken
                 (setf (ref-cut ref) (if cutting (concatenate 'string (ref-cut ref) taken) taken)
                       (ref-cutting ref) t))))
            ((= code 25) (ref-insert ref (ref-cut ref)))
            ((<= 32 code 126) (ref-insert ref (string (code-char code))))))))

;; Where the window is after it was drawn: it moves as little as shows the cursor.
(defun ref-view (ref rows columns)
  (cond ((< (ref-row ref) (ref-top ref)) (setf (ref-top ref) (ref-row ref)))
        ((>= (ref-row ref) (+ (ref-top ref) rows)) (setf (ref-top ref) (- (ref-row ref) rows -1))))
  (cond ((< (ref-column ref) (ref-left ref)) (setf (ref-left ref) (ref-column ref)))
        ((>= (ref-column ref) (+ (ref-left ref) columns)) (setf (ref-left ref) (- (ref-column ref) columns -1)))))

(let ((editor (clara.emma::open-editor nil :columns 12 :rows 5 :x 20 :y 60))
      (ref (make-ref)) (state (sb-ext:seed-random-state 13)) (apart 0) (wrong 0) (pixels 0) (most 0)
      (colored 0) (hinted 0) (deepest 0))
  (dotimes (step 700)
    (let* ((n (random 100 state))
           (code (cond ((< n 30) (char-code (char "ab (((()))" (random 10 state))))
                       ((< n 34) (char-code (char "\";|\\" (random 4 state))))
                       ((< n 45) 10)
                       ((< n 53) 8)
                       ((< n 58) 127)
                       ((< n 60) 9)
                       ((< n 66) clara.input:+up+)
                       ((< n 72) clara.input:+down+)
                       ((< n 78) clara.input:+left+)
                       ((< n 84) clara.input:+right+)
                       ((< n 86) clara.input:+home+)
                       ((< n 88) clara.input:+end+)
                       ((< n 91) clara.input:+page-up+)
                       ((< n 94) clara.input:+page-down+)
                       ((< n 97) 11)
                       (t 25))))
      (clara.emma::key editor code)
      (ref-key ref code 5)
      (unless (zerop (editor-wrong editor))     ; which draws it
        (incf wrong))
      ;; What the walk came by: cells in other colours, hints, and how deep.
      (let ((tints (editor-tints editor)))
        (incf colored (length tints))
        (when (find-if #'fourth tints)
          (incf hinted))
        (dolist (tint tints)
          (setq deepest (max deepest (or (position (third tint) *levels*) 0)))))
      (ref-view ref 5 12)
      (unless (equal (list (ref-lines ref) (ref-row ref) (ref-column ref) (ref-cut ref) (ref-top ref) (ref-left ref))
                     (append (editor-state editor)
                             (list (clara.emma::editor-cut editor) (clara.emma::editor-top editor)
                                   (clara.emma::editor-left editor))))
        (incf apart))
      (setq most (max most (length (ref-lines ref))))
      (when (zerop (mod step 50))
        (unless (eql (wrong-pixels) 0)
          (incf pixels)))))
  (check '(0 0 0 t) (list apart wrong pixels (> most 12)))
  (check '(t t t) (list (> colored 1500) (> hinted 20) (>= deepest 3)))
  (clara.windows:close-window (clara.emma::editor-window editor)))

;; The parentheses of a text. A pair has the colour of its level, the
;; outermost the first; one in a string, in a comment or after #\ has
;; none; and while the cursor stands behind a closing one, the one that
;; opens it has a block under it, the hint, in whichever row it is.
(let ((editor (clara.emma::open-editor nil :columns 20 :rows 4)))
  (flet ((wrong (rows cursor &rest tints)
           (clara.emma::render editor)
           (wrong-cells (clara.emma::editor-surface editor) (mapcar (lambda (row) (pad row 20)) rows)
                        (list (append cursor (list +ink+))) tints)))
    (keys editor "(a (b" 10 "c))")
    (check '(0 0) (list (wrong '("(a (b" "c))") '(1 3)
                               (list 0 0 (level 0) +hint+) (list 0 3 (level 1)) (list 1 1 (level 1)) (list 1 2 (level 0)))
                        (editor-wrong editor)))
    (keys editor clara.input:+left+)           ; behind the one that closes the second pair
    (check 0 (wrong '("(a (b" "c))") '(1 2)
                    (list 0 0 (level 0)) (list 0 3 (level 1) +hint+) (list 1 1 (level 1)) (list 1 2 (level 0))))
    (keys editor clara.input:+left+)           ; and behind no parenthesis
    (check 0 (wrong '("(a (b" "c))") '(1 1)
                    (list 0 0 (level 0)) (list 0 3 (level 1)) (list 1 1 (level 1)) (list 1 2 (level 0))))
    ;; A double quote above makes a string of what follows it, up to the
    ;; next one, and a semicolon a comment of the rest of its line: what
    ;; the lines below are is worked out again.
    (keys editor clara.input:+up+ clara.input:+home+ "\"")
    (check '(0 0) (list (wrong '("\"(a (b" "c))") '(0 1)) (editor-wrong editor)))
    (keys editor clara.input:+end+ "\"")
    (check 0 (wrong '("\"(a (b\"" "c))") '(0 7) (list 1 1 +stray+) (list 1 2 +stray+)))
    (keys editor clara.input:+home+ 127 clara.input:+end+ 8 clara.input:+home+ ";")
    (check 0 (wrong '(";(a (b" "c))") '(0 1) (list 1 1 +stray+) (list 1 2 +stray+)))
    (keys editor 8 "#\\( ")
    (check '(0 0) (list (wrong '("#\\( (a (b" "c))") '(0 4)
                               (list 0 4 (level 0)) (list 0 7 (level 1)) (list 1 1 (level 1)) (list 1 2 (level 0)))
                        (editor-wrong editor)))
    ;; A closing one that nothing opens has a colour of its own, and no hint.
    (keys editor clara.input:+page-down+ clara.input:+end+ ")")
    (check '(0 0) (list (wrong '("#\\( (a (b" "c)))") '(1 4)
                               (list 0 4 (level 0)) (list 0 7 (level 1)) (list 1 1 (level 1)) (list 1 2 (level 0))
                               (list 1 3 +stray+))
                        (editor-wrong editor)))
    ;; The one that opens it can be out of the window, above it or to the
    ;; left of it: then there is no hint to draw.
    (keys editor 8 10 10 10 10)
    (clara.emma::render editor)                ; the window has followed the cursor down,
    (keys editor clara.input:+up+ clara.input:+up+ clara.input:+up+ clara.input:+up+ clara.input:+end+)
    (check '(0 1 0) (list (wrong '("c))" "" "" "") '(0 3) (list 0 1 (level 1)) (list 0 2 (level 0)))
                          (clara.emma::editor-top editor) (editor-wrong editor)))
    (keys editor clara.input:+up+)
    (clara.emma::render editor)                ; and up again, to the first line
    (keys editor clara.input:+down+ clara.input:+end+)
    (check '(0 0) (list (wrong '("#\\( (a (b" "c))" "" "") '(1 3)
                               (list 0 4 (level 0) +hint+) (list 0 7 (level 1)) (list 1 1 (level 1)) (list 1 2 (level 0)))
                        (clara.emma::editor-top editor)))
    (keys editor clara.input:+page-down+ clara.input:+page-down+ "(2345678901234567890123)")
    (check '(0 5 2 0) (list (wrong '("" "" "" "678901234567890123)") '(3 19) (list 3 18 (level 0)))
                            (clara.emma::editor-left editor) (clara.emma::editor-top editor) (editor-wrong editor)))
    (keys editor clara.input:+home+)
    (check '(0 0) (list (wrong '("" "" "" "(2345678901234567890") '(3 0) (list 3 0 (level 0))) (editor-wrong editor))))
  (clara.windows:close-window (clara.emma::editor-window editor)))
;; A file of Lisp, opened: its parentheses are known as far as the window
;; shows them, and further down as the cursor goes there, by going on from
;; what was known. A #| |# comment is none of them, over as many lines as
;; it has.
(let* ((file (write-scratch "nested.lisp" "(defun f (x)" "  #| (a comment" "     (of two lines |#" "  (list x #\\) \")\"))"
                            ";; (g)" "(g (f 1))" ""))
       (editor (clara.emma::open-editor file :columns 24 :rows 3)))
  (check '(0 nil) (list (editor-wrong editor) (clara.emma::editor-states editor)))
  (keys editor clara.input:+page-down+ clara.input:+page-down+ clara.input:+end+)
  (check '(0 4 (nil :open :comment-in-it :open))
         (list (editor-wrong editor) (clara.emma::editor-row editor)
               (mapcar (lambda (state)
                         (cond ((null state) nil)
                               ((integerp (clara.syntax::state-mode state)) :comment-in-it)
                               (t :open)))
                       (clara.emma::editor-states editor))))
  (keys editor clara.input:+up+ clara.input:+end+)             ; behind the one that ends the DEFUN, three lines down
  (check '(0 3 2) (list (editor-wrong editor) (clara.emma::editor-row editor) (clara.emma::editor-top editor)))
  ;; The lines above the cursor's that were gone through are not gone
  ;; through again: what is known of them is the list that it was.
  (let ((known (clara.emma::editor-states editor)))
    (keys editor "x" 8)
    (check '(0 t) (list (editor-wrong editor) (eq known (clara.emma::editor-states editor))))
    (keys editor clara.input:+up+ clara.input:+down+)
    (check '(0 t) (list (editor-wrong editor) (eq (cdr known) (cdr (clara.emma::editor-states editor))))))
  ;; Another text in the window: nothing of the one before is known.
  (keys editor 15 15 (scratch "poem.txt") 10)
  (check '(0 nil) (list (editor-wrong editor) (clara.emma::editor-states editor)))
  (clara.windows:close-window (clara.emma::editor-window editor)))
;; What is known at the end of a line says where the parentheses are that
;; are still open there: the line and the column of each, the innermost
;; first, however many lines were gone through at a time.
(let ((editor (clara.emma::open-editor (write-scratch "open.lisp" "(a" " (b" "  (c" "(d" "(e" "(f" "") :columns 20 :rows 2)))
  (flet ((open-at ()
           (clara.emma::render editor)
           (let ((state (car (clara.emma::editor-states editor))))
             (and state (clara.syntax::state-opens state)))))
    (check nil (open-at))
    (keys editor clara.input:+down+)
    (check '((0 . 0)) (open-at))
    (keys editor clara.input:+down+)
    (check '((1 . 1) (0 . 0)) (open-at))
    (keys editor clara.input:+down+)
    (check '(((2 . 2) (1 . 1) (0 . 0)) 3 0) (list (open-at) (clara.emma::editor-row editor) (editor-wrong editor)))
    (keys editor clara.input:+up+ clara.input:+up+ clara.input:+up+ clara.input:+down+ clara.input:+down+
          clara.input:+down+)
    (check '(((2 . 2) (1 . 1) (0 . 0)) 0) (list (open-at) (editor-wrong editor)))
    ;; Several keys can come between two drawings. A line above the window
    ;; that is another by then, with as many lines above the cursor as
    ;; before, is gone through again, and the lines after it with it.
    (keys editor clara.input:+down+ clara.input:+down+)
    (check '(((4 . 0) (3 . 0) (2 . 2) (1 . 1) (0 . 0)) 5 4 0)
           (list (open-at) (clara.emma::editor-row editor) (clara.emma::editor-top editor) (editor-wrong editor)))
    (keys editor clara.input:+up+ clara.input:+up+ clara.input:+up+ clara.input:+home+ "\"" clara.input:+down+
          clara.input:+down+ clara.input:+down+)
    (check '(((1 . 1) (0 . 0)) :string 5 4 0)
           (list (open-at) (clara.syntax::state-mode (car (clara.emma::editor-states editor))) (clara.emma::editor-row editor)
                 (clara.emma::editor-top editor) (editor-wrong editor)))
    (keys editor clara.input:+up+ clara.input:+up+ clara.input:+up+ clara.input:+home+ 127 clara.input:+down+
          clara.input:+down+ clara.input:+down+)
    (check '(((4 . 0) (3 . 0) (2 . 2) (1 . 1) (0 . 0)) 0) (list (open-at) (editor-wrong editor))))
  (clara.windows:close-window (clara.emma::editor-window editor)))
;; With no colours, CLARA.SYNTAX:*COLORS*, a parenthesis is drawn like any
;; other character, and with no colour for it, *HINT*, there is no hint.
(let ((editor (clara.emma::open-editor nil :columns 20 :rows 2))
      (clara.syntax:*colors* nil) (clara.syntax:*stray* nil))
  (keys editor "(a))")
  (clara.emma::render editor)
  (check 0 (wrong-cells (clara.emma::editor-surface editor) (list (pad "(a))" 20)) (list (list 0 4 +ink+))))
  (keys editor 8)
  (clara.emma::render editor)
  (check 0 (wrong-cells (clara.emma::editor-surface editor) (list (pad "(a)" 20)) (list (list 0 3 +ink+))
                        (list (list 0 0 +ink+ +hint+))))
  (let ((clara.syntax:*hint* nil))
    (keys editor " " 8)
    (clara.emma::render editor)
    (check 0 (wrong-cells (clara.emma::editor-surface editor) (list (pad "(a)" 20)) (list (list 0 3 +ink+)))))
  (clara.windows:close-window (clara.emma::editor-window editor)))

;; The text of a file, read whole: after its last line comes one with
;; nothing in it, where the text ends, and saving writes every line but
;; that one. So a file comes back as it was, and a text with nothing in it
;; is a file with nothing in it.
(let* ((poem (write-scratch "poem.txt" "roses" "  violets" ""))
       (editor (clara.emma::open-editor poem :columns 90 :rows 4)))
  (check (list '(("roses" "  violets" "" "") 0 0) poem nil "3 lines" (concatenate 'string "Emma - " poem) 0)
         (list (editor-state editor) (clara.emma::editor-name editor) (clara.emma::editor-changed editor)
               (clara.emma::editor-message editor) (clara.windows:window-title (clara.emma::editor-window editor))
               (editor-wrong editor)))
  (keys editor 19)                                                           ; saved as it came
  (check (list (format nil "roses~%  violets~%~%") "saved, 3 lines") (list (scratch-text "poem.txt") (clara.emma::editor-message editor)))
  (keys editor "red ")
  ;; The status: which file, that it has changed, and where the cursor is.
  (let ((words (concatenate 'string poem ", not saved")) (place "line 1, column 5 "))
    (check (list (concatenate 'string " " words (make-string (- 89 (length words) (length place)) :initial-element #\Space) place) 0)
           (list (clara.emma::status editor) (editor-wrong editor))))
  (keys editor 19)
  (check (list (format nil "red roses~%  violets~%~%") nil "saved, 3 lines" 0)
         (list (scratch-text "poem.txt") (clara.emma::editor-changed editor) (clara.emma::editor-message editor)
               (editor-wrong editor)))
  (keys editor clara.input:+page-down+ "end" 19)                             ; a last line with something in it gets its end
  (check (list (format nil "red roses~%  violets~%~%end~%") "saved, 4 lines")
         (list (scratch-text "poem.txt") (clara.emma::editor-message editor)))
  (clara.windows:close-window (clara.emma::editor-window editor)))
(let ((editor (clara.emma::open-editor (scratch "empty.txt") :columns 70 :rows 3)))
  (check '((("") 0 0) "a new file: Ctrl-S makes it" nil nil)                 ; a file that is not there yet
         (list (editor-state editor) (clara.emma::editor-message editor) (clara.emma::editor-changed editor)
               (probe-file (scratch "empty.txt"))))
  (keys editor 19)
  (check '("" "saved, 0 lines") (list (scratch-text "empty.txt") (clara.emma::editor-message editor)))
  (keys editor "x" 19)
  (check (format nil "x~%") (scratch-text "empty.txt"))
  (clara.windows:close-window (clara.emma::editor-window editor)))
(let ((editor (clara.emma::open-editor (scratch "empty.txt") :columns 70 :rows 3)))
  (check '((("x" "") 0 0) "1 lines") (list (editor-state editor) (clara.emma::editor-message editor)))
  (clara.windows:close-window (clara.emma::editor-window editor)))
;; An editor that is opened on what cannot be read, a directory for one,
;; says so, and is an editor with no file: its window is not named after it,
;; and is Emma and no more, as the window of a text with no file is.
(let ((editor (clara.emma::open-editor *scratch* :columns 70 :rows 3)))
  (check '((("") 0 0) t nil nil "Emma" 0)
         (list (editor-state editor) (stringp (clara.emma::editor-message editor)) (clara.emma::editor-name editor)
               (clara.emma::editor-changed editor) (clara.windows:window-title (clara.emma::editor-window editor))
               (editor-wrong editor)))
  (clara.windows:close-window (clara.emma::editor-window editor)))

;; A question in the status row: a text that has no file is asked for a
;; name when it is saved. What is typed then is the answer, Backspace takes
;; a character of it back, Enter hands it over, and Escape gives it up.
(let ((editor (clara.emma::open-editor nil :columns 70 :rows 3)) (note (scratch "note.txt")))
  (flet ((asked ()
           (list (car (clara.emma::editor-asking editor)) (clara.emma::editor-answer editor) (editor-wrong editor))))
    (keys editor "note" 19)
    (check '("Save as: " "" 0) (asked))
    (keys editor "xyz" 8 clara.input:+up+ 9 1)
    (check '("Save as: " "xy" 0) (asked))
    (keys editor 8 8 8 10)                                                   ; no answer: nothing is saved, or tried
    (check '((nil "" 0) (("note") 0 4) t nil nil)
           (list (asked) (editor-state editor) (clara.emma::editor-changed editor) (clara.emma::editor-name editor)
                 (clara.emma::editor-message editor)))
    (keys editor 19 note 27)                                                 ; given up
    (check '(nil 0 nil nil)
           (list (car (asked)) (editor-wrong editor) (clara.emma::editor-name editor) (probe-file note)))
    (keys editor 19 note 10)
    (check (list nil note nil "saved, 1 lines" (concatenate 'string "Emma - " note) (format nil "note~%") 0)
           (list (clara.emma::editor-asking editor) (clara.emma::editor-name editor) (clara.emma::editor-changed editor)
                 (clara.emma::editor-message editor) (clara.windows:window-title (clara.emma::editor-window editor))
                 (scratch-text "note.txt") (editor-wrong editor)))
    ;; Another file, in place of this text: refused once while the text is
    ;; not saved, and done when the key is typed again right after.
    (keys editor "s" 15)
    (check '(nil "the text is not saved: Ctrl-S saves it, and asking once more goes on without")
           (list (clara.emma::editor-asking editor) (clara.emma::editor-message editor)))
    (keys editor clara.input:+left+ 15)                                      ; a key in between: refused again
    (check nil (clara.emma::editor-asking editor))
    (keys editor 15)
    (check '("Open: " "" 0) (asked))
    (keys editor (scratch "poem.txt") 10)
    (check (list '(("red roses" "  violets" "" "end" "") 0 0) (scratch "poem.txt") nil "4 lines"
                 (concatenate 'string "Emma - " (scratch "poem.txt")) 0)
           (list (editor-state editor) (clara.emma::editor-name editor) (clara.emma::editor-changed editor)
                 (clara.emma::editor-message editor) (clara.windows:window-title (clara.emma::editor-window editor))
                 (editor-wrong editor)))
    ;; What cannot be read, a directory for one, is said, and the text stays,
    ;; under the title that it had.
    (keys editor 15 *scratch* 10)
    (check (list t '(("red roses" "  violets" "" "end" "") 0 0) (scratch "poem.txt") nil
                 (concatenate 'string "Emma - " (scratch "poem.txt")))
           (list (stringp (clara.emma::editor-message editor)) (editor-state editor) (clara.emma::editor-name editor)
                 (clara.emma::editor-asking editor) (clara.windows:window-title (clara.emma::editor-window editor))))
    ;; Closing: at once when the text is saved; refused once when it is not,
    ;; whether it is Ctrl-Q or the close box that asks.
    (keys editor 17)
    (check t (clara.emma::editor-done editor))
    (setf (clara.emma::editor-done editor) nil)
    (keys editor "!" 17)
