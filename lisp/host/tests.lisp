             (unless (equal (picture *canvas*)
                            (expected 12 8 (lambda (px py)
                                             (cond ((arrow-p (- px x) (- py y)) 4)
                                                   ((and background (<= x px (+ x 6)) (<= y py (+ y 6))) background)
                                                   (t 9)))))
               (incf wrong))))
    (check '(bitmap 0) (list 'bitmap wrong))))
