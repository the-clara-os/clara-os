            (list "https://pages.test/gone.html" "<title>Not here</title><h1>404</h1><p>No such page." :page 404)
            (list "https://pages.test/broken" "" :page 500)
            (list "https://pages.test/moved" "https://pages.test/dir/other.html" :moved)
