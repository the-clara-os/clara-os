                                                    (cond ((text-p string (- px x) (- py y)) 4)
                                                          ((and background (<= x px (+ x 31)) (<= y py (+ y 15))) background)
                                                          (t 9))))))
                        (unless (and (equal want (picture *canvas*))
                                     (eq drew (and (< -32 x 30) (< -16 y 20))))
                          (incf wrong)))))
    (check '(text 0) (list 'text wrong))))
