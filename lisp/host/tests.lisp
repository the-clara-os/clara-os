    (check '(("fec0::5054:ff:fe12:3456" "fe80::5054:ff:fe12:3456") "fec0::5054:ff:fe12:3456" "fec0::2")
           (list (clara.net:addresses) (clara.net:address) (clara.net:resolve "six.test")))
