;;;; host/tests.lisp: the Lisp of ClaraOS, tested under SBCL
;;;;
;;;; usage: sbcl --script lisp/host/tests.lisp        (`make test` runs it before the boots)
;;;;
;;;; The files in lisp/ are loaded here as they stand, on top of the machine
;;;; that host/clara.lisp makes up, and put through what a boot cannot look
;;;; at closely: every byte the console sends, every pixel it draws, every
;;;; key it is typed. The file that SBCL cannot load, boot.lisp, and the
;;;; functions that the substrate has in C are checked in another way: by
;;;; their names, against Common Lisp's own and against the stand-ins here.
;;;; A check that fails says so, and the run ends with status 1.

(defpackage "CLARA.TESTS"
  (:use "COMMON-LISP"))
(in-package "CLARA.TESTS")

(defvar *root* (merge-pathnames "../../" (make-pathname :name nil :type nil :defaults *load-truename*)))

;; A driver that waits for a device which never answers would wait for
;; good, and the tests with it. They take seconds, so after two minutes
;; something has gone wrong, and the run ends with that.
(sb-thread:make-thread (lambda ()
                         (sleep 120)
                         (format t "host tests: FAILED: still running after two minutes: something waits for what never comes~%")
                         (finish-output)
                         (sb-ext:exit :code 1 :abort t))
                       :name "watchdog")
(defvar *checks* 0)
(defvar *failures* 0)

(defun source (name)
  (merge-pathnames name *root*))

(defun failed (control &rest arguments)
  (incf *failures*)
  (format t "host tests: FAILED: ~?~%" control arguments))

;; FORM has to give EXPECTED, by EQUAL.
(defmacro check (expected form)
  `(let ((expected ,expected)
         (got (handler-case ,form
                (serious-condition (condition) (list :condition (princ-to-string condition))))))
     (incf *checks*)
     (unless (equal expected got)
       (failed "~S gave ~S, not ~S" ',form got expected))))

;; FORM has to signal a condition of TYPE.
(defmacro check-condition (type form)
  `(progn
     (incf *checks*)
     (handler-case (progn ,form (failed "~S did not signal ~S" ',form ',type))
       (,type () nil))))

;; What the error says that FUNCTION ends in, or NIL when it ends in none.
(defun condition-text (function)
  (handler-case (progn (funcall function) nil)
    (error (condition) (princ-to-string condition))))

;;; The sources: each has to load, and without a warning.

(defun load-source (name)
  (handler-bind ((warning (lambda (condition)
                            (unless (typep condition 'style-warning)
                              (failed "~A: ~A" name condition)))))
    (load (source name))))

(load-source "lisp/host/clara.lisp")
(load-source "lisp/compiler.lisp")
(load-source "lisp/host/vm.lisp")              ; the machine that runs what the compiler makes
(load-source "lisp/native.lisp")               ; what makes code for the processor of that, and the two processors,
(load-source "lisp/arm64.lisp")                ; of which a kernel loads its own
(load-source "lisp/x86-64.lisp")
(load-source "lisp/font.lisp")
(load-source "lisp/console.lisp")
(load-source "lisp/draw.lisp")
(load-source "lisp/pci.lisp")
(load-source "lisp/virtio.lisp")
(load-source "lisp/usb.lisp")
(load-source "lisp/input.lisp")
(load-source "lisp/disk.lisp")
(load-source "lisp/fat.lisp")
(load-source "lisp/type.lisp")
(load-source "lisp/random.lisp")
(load-source "lisp/net.lisp")
(load-source "lisp/hda.lisp")
(load-source "lisp/sound.lisp")
(load-source "lisp/syntax.lisp")
(load-source "lisp/listener.lisp")
(load-source "lisp/windows.lisp")
(load-source "lisp/terminal.lisp")
(load-source "lisp/system.lisp")
(load-source "lisp/tls.lisp")
(load-source "lisp/parker.lisp")
(load-source "lisp/emma.lisp")               ; the three that the kernel leaves on the volume for the launcher to load
(load-source "lisp/jaid.lisp")
(load-source "lisp/ares.lisp")
(defvar *defined-applications* clara.windows::*applications*) ; what the files defined, for the tests to put back
(defvar *defined-commands* clara.windows::*commands*)

;; What this system knows of where ClaraOS is published, and the key that
;; it holds a release against: an address that begins with https:// and
;; ends with a /, and the 64 digits of a key. The tests are then run by a
;; system that knows of neither, as one is that somebody builds for a
;; place of their own, and each says where it looks and with which key:
;; what is tested here asks nothing of the place that the system names.
(check '(t #\/ 64 t)
       (list (and (clara.net::secure-address-p clara.system:*releases*) t)
             (char clara.system:*releases* (1- (length clara.system:*releases*)))
             (length clara.system:*release-key*)
             (and (every (lambda (digit) (digit-char-p digit 16)) clara.system:*release-key*) t)))
(setq clara.system:*releases* nil
      clara.system:*release-key* nil)
;; The same for where packages are published (lisp/parker.lisp): one source,
;; beside the releases, whose index is signed with the key of the releases.
(check '(("https://claraos.org/packages/" "2c67792528bac0b3570bb966e176e9b60ee04bfa0084ce50676db6cd8fca8dc6"))
       clara.parker:*sources*)
(setq clara.parker:*sources* nil)

;;; Names. boot.lisp is the part of Common Lisp that ClaraOS has in Lisp,
;;; and SBCL has all of it already, so it is read here as text. What it
;;; exports from COMMON-LISP has to be Common Lisp's, what it defines there
;;; has to be exported, or begin with a %, and what it and the substrate
;;; put in CLARA and CLARA.UNSAFE has to be in the stand-ins of host/ too:
;;; a name that is only on one side is a program that loads only there.

(defun file-text (name)
  (with-open-file (stream (source name) :external-format :utf-8)
    (let ((text (make-string (file-length stream))))
      (subseq text 0 (read-sequence text stream)))))

(defun lines (text)
  (let ((start 0) (lines nil))
    (loop
      (let ((end (position #\Newline text :start start)))
        (push (subseq text start end) lines)
        (unless end
          (return (nreverse lines)))
        (setq start (1+ end))))))

(defun words (text)
  (let ((words nil) (start nil))
    (dotimes (i (1+ (length text)) (nreverse words))
      (let ((blank (or (= i (length text)) (find (char text i) " ()'\"
"))))
        (cond ((and blank start)
               (push (string-upcase (subseq text start i)) words)
               (setq start nil))
              ((and (not blank) (not start))
               (setq start i)))))))

(defun starts-with (prefix line)
  (and (>= (length line) (length prefix)) (string= prefix line :end2 (length prefix))))

;; The lines of boot.lisp from the one that begins with FROM up to the one
;; that begins with TO, or to the end.
(defun section (lines from to)
  (let ((rest (if from (member-if (lambda (line) (starts-with from line)) lines) lines)))
    (ldiff rest (and to (member-if (lambda (line) (starts-with to line)) rest)))))

;; The names that a section defines at the start of a line.
(defun definitions (lines)
  (let ((names nil))
    (dolist (line lines (nreverse names))
      (dolist (definer '("(defun " "(defmacro " "(defvar " "(defparameter " "(defconstant "
                         "(define-condition " "(defstruct "))
        (when (starts-with definer line)
          (push (first (words (subseq line (length definer)))) names))))))

;; The names in the first (export '(...)) of a section.
(defun exports (lines)
  (let* ((text (format nil "~{~A~%~}" lines))
         (start (search "(export '(" text))
         (end (and start (search "))" text :start2 start))))
    (and end (words (subseq text (+ start (length "(export '(")) end)))))

(defun external-p (name package)
  (eq (nth-value 1 (find-symbol name package)) :external))

;; The names of the rows of a table in a C file: lines like { "NAME", ...
(defun table-names (name)
  (let ((names nil))
    (dolist (line (lines (file-text name)) (nreverse names))
      (when (starts-with "    { \"" line)
        (push (subseq line 7 (position #\" line :start 7)) names)))))

(let* ((boot (lines (file-text "lisp/boot.lisp")))
       (language (section boot nil "(in-package \"CLARA\")"))
       (clara (section boot "(in-package \"CLARA\")" "(in-package \"CLARA.UNSAFE\")"))
       ;; What is external in COMMON-LISP: the list in boot.lisp, and what the substrate has in C.
       (exported (append (exports language) (table-names "kernel/lisp/builtin.c") (table-names "kernel/lisp/eval.c"))))
  (check t (> (length (exports language)) 100))
  (dolist (name (exports language))
    (incf *checks*)
    (unless (external-p name "COMMON-LISP")
      (failed "boot.lisp exports ~A from COMMON-LISP, which Common Lisp does not have" name)))
  (dolist (name (definitions language))
    (incf *checks*)
    (unless (or (char= (char name 0) #\%) (member name exported :test #'string=))
      (failed "boot.lisp defines ~A in COMMON-LISP and does not export it" name)))
  (dolist (name (append (exports clara) (definitions clara)))
    (incf *checks*)
    (unless (or (char= (char name 0) #\%) (external-p name "CLARA"))
      (failed "boot.lisp has ~A in CLARA, and lisp/host/clara.lisp does not" name))))

(dolist (name (table-names "kernel/lisp/builtin.c"))
  (incf *checks*)
  (let* ((colon (position #\: name))
         (package (if colon (subseq name 0 colon) "COMMON-LISP"))
         (name (if colon (subseq name (1+ colon)) name)))
    (cond ((starts-with "%SET-" name)
           (when colon
             (unless (fboundp (list 'setf (find-symbol (subseq name 5) package)))
               (failed "the substrate has ~A::~A, and under SBCL nothing sets ~A" package name (subseq name 5)))))
          ((char= (char name 0) #\%))
          ((not (external-p name package))
           (failed "the substrate has the function ~A:~A, and SBCL has no such symbol" package name)))))

(dolist (name (table-names "kernel/lisp/eval.c"))
  (incf *checks*)
  (unless (or (string= name "QUASIQUOTE") (external-p name "COMMON-LISP"))
    (failed "the evaluator has the special form ~A, which Common Lisp does not have" name)))

;;; What the files of the world call. Each of them loads here, under SBCL,
;;; which has all of Common Lisp, and on the machine, which has the part of
;;; it that lisp/boot.lisp, lisp/clos.lisp and the substrate define. A
;;; function that only SBCL has passes every test here, and fails on the
;;; machine the first time it is called: on a way that no boot takes, that
;;; is never under `make test`. (CEILING was one, in the driver for USB,
;;; where a controller is given the pages that it wants for itself, which
;;; QEMU's never wants.) So every file is read as text, and a word that
;;; stands first in a pair of parentheses there, or behind #', and is a
;;; function, a macro or a special form of Common Lisp's, has to be one
;;; that the machine has. A variable with such a name that stands first in
;;; its binding is taken for a call too, which is why the few names that
;;; the files bind and never call are listed here.

(defvar *bound-and-never-called* '("COUNT" "STEP" "BYTE" "BIT" "READ"))

(defun called-names (text)
  (let ((names nil) (i 0) (n (length text)))
    (flet ((word-at (start)
             (let ((end (or (position-if (lambda (c) (find c " ()'\"`,;
")) text :start start) n)))
               (when (> end start)
                 (pushnew (string-upcase (subseq text start end)) names :test #'string=)))))
      (loop
        (when (>= i n)
          (return names))
        (let ((c (char text i)))
          (cond ((char= c #\;)                    ; a comment, to the end of its line
                 (setq i (or (position #\Newline text :start i) n)))
                ((char= c #\")                    ; a string, to the quote that no backslash stands before
                 (incf i)
                 (loop
                   (when (or (>= i n) (char= (char text i) #\"))
                     (return))
                   (incf i (if (char= (char text i) #\\) 2 1)))
                 (incf i))
                ((and (char= c #\#) (< (1+ i) n) (char= (char text (1+ i)) #\\))
                 (incf i 3))                      ; a character, which may be a parenthesis
                ((and (char= c #\#) (< (1+ i) n) (char= (char text (1+ i)) #\'))
                 (word-at (+ i 2))
                 (incf i 2))
                ((char= c #\()
                 (word-at (1+ i))
                 (incf i))
                (t (incf i))))))))

(let* ((boot (lines (file-text "lisp/boot.lisp")))
       (has (append (exports boot) (definitions boot) (table-names "kernel/lisp/builtin.c")
                    (table-names "kernel/lisp/eval.c") (exports (lines (file-text "lisp/clos.lisp")))))
       (files (remove-if (lambda (file) (member (pathname-name file) '("boot" "clos") :test #'string=))
                         (directory (merge-pathnames "lisp/*.lisp" *root*)))))
  (check t (> (length files) 20))
  (check '("CAR" "FOO" "MAPCAR" "QUOTE-NOT") (sort (called-names "(car x) ; (cdr y)
\"(cons 1 2)\" #\\( (foo #'mapcar '(quote-not))") #'string<))
  (dolist (file files)
    (dolist (name (called-names (file-text (format nil "lisp/~A.lisp" (pathname-name file)))))
      (incf *checks*)
      (multiple-value-bind (symbol status) (find-symbol name "COMMON-LISP")
        (when (and (eq status :external)
                   (or (fboundp symbol) (special-operator-p symbol))
                   (not (member name has :test #'string=))
                   (not (member name *bound-and-never-called* :test #'string=)))
          (failed "lisp/~A.lisp calls ~A, which SBCL has and the machine has not" (pathname-name file) name))))))

;;; The object system (lisp/clos.lisp). It is the second file that SBCL
;;; cannot load as it stands: the names that it exports from COMMON-LISP on
;;; the kernel are SBCL's own here. So it is read a form at a time into
;;; CLARA.CLOS with those names hidden behind symbols of that package, and
;;; what it asks of the substrate is answered by lisp/host/objects.lisp.
;;; That leaves two object systems side by side, this one and SBCL's, and
;;; the second is the one piece of these tests that nobody here wrote:
;;; whatever is asked of the one is asked of the other, and the answers
;;; have to be the same.

(defvar *object-names* nil)

(defun load-objects ()
  (with-open-file (stream (source "lisp/clos.lisp") :external-format :utf-8)
    (let* ((*package* (find-package "CLARA.TESTS"))
           (first (read stream)) (second (read stream)) (third (read stream)) (fourth (read stream)))
      (unless (and (equal first '(in-package "COMMON-LISP")) (eq (car second) 'export)
                   (eq (car third) 'defpackage) (equal fourth '(in-package "CLARA.CLOS")))
        (failed "lisp/clos.lisp does not begin with the four forms that the tests take it by"))
      (setq *object-names* (mapcar #'symbol-name (cadr (cadr second))))
      (eval third)
      (shadow *object-names* "CLARA.CLOS")
      (load-source "lisp/host/objects.lisp")
      (let ((*package* (find-package "CLARA.CLOS")))
        (loop
          (let ((form (read stream nil stream)))
            (when (eq form stream)
              (return))
            (handler-bind ((warning (lambda (condition)
                                      (unless (typep condition 'style-warning)
                                        (failed "lisp/clos.lisp: ~A" condition))
                                      (muffle-warning condition))))
              (eval form))))))))

(load-objects)
(dolist (name '("STANDARD-OBJECT" "CLASS" "STANDARD-GENERIC-FUNCTION" "STANDARD-METHOD"))
  (clara.clos::printed-by-method (find-symbol name "CLARA.CLOS")))

;; A name that the file exports has to be Common Lisp's, and one that the
;; language had before it: such a name the file may call, and here it would
;; be calling a symbol of its own that nothing defines.
(let ((had (append (exports (section (lines (file-text "lisp/boot.lisp")) nil "(in-package \"CLARA\")"))
                   (table-names "kernel/lisp/builtin.c") (table-names "kernel/lisp/eval.c"))))
  (check t (> (length *object-names*) 50))
  (dolist (name *object-names*)
    (incf *checks*)
    (cond ((not (external-p name "COMMON-LISP"))
           (failed "clos.lisp exports ~A from COMMON-LISP, which Common Lisp does not have" name))
          ((member name had :test #'string=)
           (failed "clos.lisp exports ~A from COMMON-LISP, which the language has without it" name)))))

;; A transcript, as tools/boottest.sh types one at a kernel: the lines
;; that begin with "> ", and with two spaces for a form that goes on, are
;; typed, and the lines after them are the answer.
(defun transcript (name)
  (let ((entries nil) (typed nil) (answer nil))
    (flet ((entry ()
             (when typed
               (push (list typed (reverse answer)) entries))
             (setq typed nil answer nil)))
      (dolist (line (lines (file-text name)))
        (cond ((starts-with "> " line)
               (entry)
               (setq typed (subseq line 2)))
              ((and typed (null answer) (starts-with "  " line))
               (setq typed (format nil "~A~%~A" typed (subseq line 2))))
              ((and typed (plusp (length line)))
               (push line answer))))
      (entry))
    (reverse entries)))

;; What a listener answers to a text that is read in PACKAGE, as
;; lisp/listener.lisp does it: what the forms write, the values of each on
;; a line of its own, or the error; and whether there was an error. What
;; SBCL's compiler has to say of a form that is meant to fail goes nowhere.
(defun answer-of (text package)
  (let ((*package* package) (*print-pretty* nil) (error nil) (*error-output* (make-broadcast-stream)))
    (values (remove "" (lines (with-output-to-string (*standard-output*)
                                (handler-case
                                    (handler-bind ((warning #'muffle-warning))
                                      (let ((start 0))
                                        (loop
                                          (multiple-value-bind (form position)
                                              (read-from-string text nil text :start start)
                                            (when (eq form text)
                                              (return))
                                            (setq start position)
                                            (dolist (value (multiple-value-list (eval form)))
                                              (fresh-line)
                                              (prin1 value))
                                            (fresh-line)))))
                                  (serious-condition (condition)
                                    (setq error t)
                                    (fresh-line)
                                    (format t "error: ~A" condition)))))
                    :test #'string=)
            error)))

;; The two worlds: OBJECTS.SBCL has Common Lisp as SBCL has it, and
;; OBJECTS.CLARA the same with the names of lisp/clos.lisp in place of
;; SBCL's.
(defvar *theirs* (make-package "OBJECTS.SBCL" :use '("COMMON-LISP")))
(defvar *ours* (make-package "OBJECTS.CLARA" :use '("COMMON-LISP")))
(shadowing-import (mapcar (lambda (name) (find-symbol name "CLARA.CLOS")) *object-names*) *ours*)

;; tools/objects.txt is typed at a kernel by `make test`, which holds the
;; kernel to its answers. Here the same forms are given to lisp/clos.lisp
;; under SBCL, which has to give those answers to the letter, and to SBCL's
;; own object system, which has to give them too: where the answer is an
;; error it has to fail, in whatever words, and where the answer shows an
;; object that has no text to read back, a #<, it has to go well. So a form
;; of that file says nothing that the two systems put differently, and
;; every error in it is one that lisp/clos.lisp words itself.
(let ((entries (transcript "tools/objects.txt")))
  (check t (> (length entries) 150))
  (dolist (entry entries)
    (destructuring-bind (text expected) entry
      (incf *checks*)
      (let ((ours (answer-of text *ours*)))
        (unless (equal ours expected)
          (failed "~A~%   lisp/clos.lisp answers ~S~%   and tools/objects.txt has ~S" text ours expected)))
      (multiple-value-bind (theirs error) (answer-of text *theirs*)
        (cond ((some (lambda (line) (starts-with "error: " line)) expected)
               (unless error
                 (failed "~A~%   SBCL answers ~S~%   where tools/objects.txt has an error" text theirs)))
              ((some (lambda (line) (search "#<" line)) expected)
               (when error
                 (failed "~A~%   SBCL answers ~S" text theirs)))
              ((not (equal theirs expected))
               (failed "~A~%   SBCL answers ~S~%   and tools/objects.txt has ~S" text theirs expected)))))))

;; Where lisp/clos.lisp is not SBCL on purpose, it is asked alone. The class
;; of an object of the language's own is the standard's, where SBCL has
;; classes of its own below those: a 5 is an INTEGER here, and a FIXNUM
;; there.
(flet ((ours (text)
         (answer-of text *ours*)))
  (check '("(INTEGER CHARACTER SYMBOL NULL CONS STRING VECTOR FUNCTION PACKAGE)")
         (ours "(mapcar (lambda (x) (class-name (class-of x)))
                        (list 5 #\\a 'a nil '(1) \"s\" (vector 1) #'car (find-package \"KEYWORD\")))"))
  (check '("((NULL SYMBOL LIST SEQUENCE T) (STRING VECTOR ARRAY SEQUENCE T) (INTEGER RATIONAL REAL NUMBER T) (CONS LIST SEQUENCE T))")
         (ours "(mapcar (lambda (name) (mapcar #'class-name (clara.clos::class-precedence-list (find-class name))))
                        '(null string integer cons))"))
  ;; A function that is defined under the name of a generic function is an ordinary function from then
  ;; on, and a method for the name makes a new generic function, with none of the old one's methods.
  ;; SBCL refuses the method.
  (ours "(defgeneric morph (thing) (:method ((thing integer)) 'generic) (:method ((thing symbol)) 'a-symbol))")
  (check '("MORPH" "PLAIN") (ours "(defun morph (thing) thing 'plain) (morph 1)"))
  (check '("AGAIN" "error: MORPH has no method for the arguments (A)")
         (ours "(progn (defmethod morph ((thing integer)) 'again) (morph 1)) (morph 'a)"))
  ;; A class that cannot be defined again as it is asked stays what it was, with the classes below it:
  ;; A would be a kind of D, which is a kind of it. SBCL leaves such a class half done.
  (check '("REFUSED" "((B C) (D B C A STANDARD-OBJECT T) (X))")
         (ours "(handler-case (defclass a (d) ()) (error () 'refused))
                (let ((d (make-instance 'd)))
                  (list (list (x d) (y d)) (mapcar #'class-name (clara.clos::class-precedence-list (find-class 'd)))
                        (mapcar #'clara.clos::slot-name (clara.clos::class-direct-slots (find-class 'a)))))")))

;; The same text in both worlds, which have to answer alike: both with an
;; error, or both with the same values, as far as a value has a text that
;; reads back.
(defun both (control &rest arguments)
  (let ((text (apply #'format nil control arguments)))
    (incf *checks*)
    (multiple-value-bind (ours our-error) (answer-of text *ours*)
      (multiple-value-bind (theirs their-error) (answer-of text *theirs*)
        (cond ((or our-error their-error)
               (unless (and our-error their-error)
                 (failed "~A~%   lisp/clos.lisp answers ~S~%   and SBCL ~S" text ours theirs)))
              ((some (lambda (line) (search "#<" line)) ours))
              ((not (equal ours theirs))
               (failed "~A~%   lisp/clos.lisp answers ~S~%   and SBCL ~S" text ours theirs)))
        (values (not our-error) ours)))))

;; Numbers that are the same at every run.
(defvar *chance* 20261122)
(defun chance (below)
  (setq *chance* (mod (+ (* *chance* 1103515245) 12345) 2147483648))
  (mod (floor *chance* 65536) below))

;; Classes made at random, each a kind of up to three of the ones before
;; it, in an order that chance picks: 300 of them, of which a good part
;; cannot be put in an order at all. The two systems have to refuse the
;; same ones, and to put the others in the same order to the last class.
;; SBCL says so when the class is first needed, and here it is said as the
;; class is defined; a class that was refused is not built on, and SBCL,
;; which keeps such a class, is told that it is a kind of nothing.
(defvar *made-classes* nil)
(dotimes (i 300)
  (let ((above nil))
    (dotimes (j (chance 4))
      (when *made-classes*
        (pushnew (nth (chance (min 12 (length *made-classes*))) *made-classes*) above)))
    (incf *checks*)
    (let* ((definition (format nil "(defclass rc~D (~{rc~D~^ ~}) ())" i above))
           (ours (nth-value 1 (answer-of definition *ours*)))
           (theirs (nth-value 1 (answer-of (format nil "(progn ~A (sb-mop:finalize-inheritance (find-class 'rc~D)))"
                                                   definition i)
                                           *theirs*))))
      (cond ((not (eq ours theirs))
             (failed "~A: lisp/clos.lisp ~:[takes~;refuses~] it, and SBCL ~:[takes~;refuses~] it"
                     definition ours theirs))
            (ours
             (answer-of (format nil "(defclass rc~D () ())" i) *theirs*))
            (t
             (push i *made-classes*)
             (let ((ours (answer-of (format nil "(mapcar #'class-name (clara.clos::class-precedence-list (find-class 'rc~D)))" i)
                                    *ours*))
                   (theirs (answer-of (format nil "(remove 'sb-pcl::slot-object (mapcar #'class-name (sb-mop:class-precedence-list (find-class 'rc~D))))" i)
                                      *theirs*)))
               (unless (equal ours theirs)
                 (failed "the classes above RC~D (~{RC~D~^ ~}):~%   lisp/clos.lisp has ~A~%   and SBCL ~A"
                         i above ours theirs))))))))
(check t (> (length *made-classes*) 150))
(check t (< (length *made-classes*) 290))

;; Methods at random for pairs of those classes, each of which says its
;; number and calls on when there is a next one, and then calls with
;; instances of pairs of classes at random: which methods run, and in which
;; order, has to be the same in both systems, call for call.
(both "(defgeneric rg (one other))")
(both "(defmethod rg (one other) (list 'last))")
(dotimes (i 120)
  (both "(progn (defmethod rg ((one rc~D) (other rc~D)) (cons ~D (if (next-method-p) (call-next-method) '(none)))) ~D)"
        (nth (chance (length *made-classes*)) *made-classes*)
        (nth (chance (length *made-classes*)) *made-classes*)
        i i)
  (dotimes (j 4)
    (both "(rg (make-instance 'rc~D) (make-instance 'rc~D))"
          (nth (chance (length *made-classes*)) *made-classes*)
          (nth (chance (length *made-classes*)) *made-classes*))))

;; The same with the words that go before a method's parameters, and for
;; one argument: what runs before, around and after, and in which order.
(both "(defvar *ran* nil)")
(both "(defgeneric rq (thing))")
(both "(defmethod rq (thing) (push 'last *ran*) 'value)")
(dotimes (i 80)
  (let ((class (nth (chance (length *made-classes*)) *made-classes*)))
    (case (chance 4)
      (0 (both "(progn (defmethod rq ((thing rc~D)) (push ~D *ran*) (call-next-method)) ~D)" class i i))
      (1 (both "(progn (defmethod rq :before ((thing rc~D)) (push '(before ~D) *ran*)) ~D)" class i i))
      (2 (both "(progn (defmethod rq :after ((thing rc~D)) (push '(after ~D) *ran*)) ~D)" class i i))
      (3 (both "(progn (defmethod rq :around ((thing rc~D)) (push '(around ~D) *ran*) (list ~D (call-next-method))) ~D)"
               class i i i))))
  (dotimes (j 3)
    (both "(progn (setq *ran* nil) (list (rq (make-instance 'rc~D)) (reverse *ran*)))"
          (nth (chance (length *made-classes*)) *made-classes*))))

;; Classes that are defined again, at random. They are a second family,
;; each a kind of up to three of the ones before it with the newest first,
;; which is an order that can always be had: SBCL keeps a class that it
;; refused among the ones below the classes it was to be a kind of, and
;; trips over it when one of those is defined again. Each has an instance,
;; and some have a method. Then, thirty times over, one of them is defined
;; again with other classes above it, with or without the slot that it
;; had, and with a new one; and after each of those every third instance is
;; asked what it holds, what it is, and which methods run for it. The
;; instances have to follow, and the two systems to agree.
(defun older (i)
  (let ((above nil))
    (dotimes (j (chance 4))
      (when (plusp i)
        (pushnew (chance i) above)))
    (sort above #'>)))

(both "(defgeneric rs (thing) (:method ((thing t)) nil))")
(dotimes (i 30)
  (both "(progn (defclass rd~D (~{rd~D~^ ~}) ((own~D :initarg :own :initform ~D :accessor own~D))) ~D)"
        i (older i) i i i i)
  (both "(defvar *rd~D* (make-instance 'rd~D :own '(given ~D)))" i i i)
  (when (zerop (chance 2))
    (both "(progn (defmethod rs ((thing rd~D)) (cons ~D (call-next-method))) ~D)" i i i)))
(dotimes (step 30)
  (let ((i (chance 30)))
    (both "(progn (defclass rd~D (~{rd~D~^ ~}) (~:[~*~*~*~;(own~D :initarg :own :initform ~D :accessor own~D) ~](more~D :initform '(more ~D) :accessor more~D))) ~D)"
          i (older i) (zerop (chance 2)) i i i i step i step)
    (dotimes (j 30)
      (when (= (mod (+ j step) 3) 0)
        (both "(list (rs *rd~D*) (handler-case (own~D *rd~D*) (error () 'gone)) (handler-case (more~D *rd~D*) (error () 'none)) (typep *rd~D* 'rd~D) (typep *rd~D* 'rd~D))"
              j j j i j j i j (chance 30))))))

;;; Whatever the compiler makes from here on is translated for the two
;;; processors as well (lisp/native.lisp), each function for both, and the
;;; code is looked at as far as that can be done without a processor to
;;; run it: further down, where the rest about such code is.
(defvar *translations* 0)

(defun code-p (object)
  (and (vectorp object) (= (length object) 13) (vectorp (aref object 0)) (vectorp (aref object 1))))

(defun translation-labels (items)
  (let ((placed nil) (named nil))
    (dolist (item items)
      (cond ((eq (car item) :label) (push (cadr item) placed))
            ((member (car item) '(:jump :jump-if :jump-tag :jump-not-tag :jump-odd :jump-bit-clear :add-over
                                  :sub-over :word :call-local))
             (push (car (last item)) named))))
    (cond ((/= (length placed) (length (remove-duplicates placed :test #'eq))) "a label is put in two places")
          ((notevery (lambda (label) (member label placed :test #'eq)) named) "a jump goes to a label that is nowhere"))))

(defun check-translation (code)
  (dolist (machine '(:arm64 :x86-64))
    (let ((clara.native::*machine* machine))
      (multiple-value-bind (items leave fast hidden) (clara.native::lower code)
        (let ((words (clara.native::assemble items (get machine 'clara.native::writer)
                                             (get machine 'clara.native::unit)))
              (title (clara.compiler::code-title code)))
          (incf *checks*)
          (incf *translations*)
          (cond ((null words) (failed "no code for ~A was made of ~S" machine title))
                ((notevery (lambda (word) (typep word '(unsigned-byte 32))) words)
                 (failed "the code for ~A of ~S is not words of 32 bits" machine title))
                ((not (and (eql (car leave) 12) (eql (car fast) 20)))
                 (failed "the code for ~A of ~S begins with ~S and ~S bytes, and not the 12 and 20 of machine.h"
                         machine title (car leave) (car fast)))
                ((translation-labels items)
                 (failed "in the code for ~A of ~S, ~A" machine title (translation-labels items)))
                ((not (eql hidden (if (clara.native::plain-p (aref code 0)) 0 2)))
                 (failed "a call of ~S hides ~S words" title hidden)))))))
  (loop for constant across (aref code 1)
        when (code-p constant) do (check-translation constant)))

(clara.native:start)
(setq clara.native:*translate* t
      clara.compiler::*translator* (lambda (code)
                                     (when clara.native:*translate*
                                       (check-translation code))
                                     (clara.native::translate-compiled code)))

;;; The compiler. What it makes of a form runs here on the machine of
;;; host/vm.lisp, and SBCL says what the form means: every form below is
;;; evaluated twice, by SBCL's own evaluator and compiled by
;;; lisp/compiler.lisp, and the two have to give the same values, or both
;;; an error. The kernel holds its compiler against its evaluator in the
;;; same way, with the texts of its self-test (kernel/lisp/lisp.c).

;; The instructions are the kernel's, by their numbers, and the special
;; forms the evaluator's, each with as many parts.
(check (table-names "kernel/lisp/vm.c")
       (mapcar (lambda (row) (symbol-name (car row))) clara.compiler::*operations*))
(dolist (line (lines (file-text "kernel/lisp/eval.c")))
  (when (starts-with "    { \"" line)
    (let* ((parts (words (substitute #\Space #\, line)))
           (known (assoc (second parts) clara.compiler::*special-forms* :test #'string=)))
      (incf *checks*)
      (cond ((string= (second parts) "QUASIQUOTE"))     ; the reader's own, which SBCL reads another way
            ((null known)
             (failed "the evaluator has the special form ~A, and the compiler does not" (second parts)))
            ((not (equal (list (second known) (third known))
                         (list (parse-integer (fourth parts))
                               (and (string/= (fifth parts) "LISP_MANY") (parse-integer (fifth parts))))))
             (failed "the compiler takes ~A with ~A to ~A parts, and the evaluator with ~A to ~A"
                     (second parts) (second known) (third known) (fourth parts) (fifth parts)))))))

(check '(clara.compiler::compile-lambda clara.compiler::list-function clara.compiler:evaluate)
       (clara.host:provided-compiler))

;; The instructions after FAIL stand for functions in C, each under the
;; name of its function, which it calls when it cannot do the work itself:
;; so the function has to be one of builtin.c's, and take as many arguments
;; as the instruction does.
(let ((known (cdr (member :fail clara.compiler::*operations* :key #'car)))
      (table (lines (file-text "kernel/lisp/builtin.c"))))
  (check 20 (length known))
  (dolist (row known)
    (incf *checks*)
    (let* ((function (find-symbol (symbol-name (car row)) "COMMON-LISP"))
           (arguments (- 1 (second row)))
           (line (find-if (lambda (line) (starts-with (format nil "    { \"~A\", " (car row)) line)) table))
           (parts (and line (words (substitute #\Space #\, line)))))
      (cond ((not (and function (eq (get function 'clara.compiler::instruction) (car row))))
             (failed "the machine has the instruction ~A, and the compiler has no function for it" (car row)))
            ((null parts)
             (failed "the machine has the instruction ~A, and no function in C has that name" (car row)))
            ((or (< arguments (parse-integer (fourth parts)))
                 (and (string/= (fifth parts) "LISP_MANY") (> arguments (parse-integer (fifth parts)))))
             (failed "the instruction ~A takes ~A arguments, and the function in C ~A to ~A"
                     (car row) arguments (fourth parts) (fifth parts)))))))

;; Such an instruction looks whether its name still means the function in
;; C, in a word that is kept right where a symbol is given a function
;; (lisp_set_function, kernel/lisp/vm.c). So nothing else may write the
;; function of a symbol, apart from the evaluator as it starts, which has
;; the machine look afterwards.
(let ((writes nil))
  (dolist (file (directory (merge-pathnames "*.c" (source "kernel/lisp/"))))
    (let ((name (format nil "kernel/lisp/~A.c" (pathname-name file))))
      (dolist (line (lines (file-text name)))
        (when (and (search "lisp_as_symbol(" line) (search ")->function = " line))
          (push name writes)))))
  (check '("kernel/lisp/eval.c" "kernel/lisp/eval.c" "kernel/lisp/vm.c") (sort writes #'string<)))

;; What a form gives: its values, or :ERROR.
(defun outcome (function form)
  (handler-case (multiple-value-list (funcall function form))
    (error () :error)))

(defun reference (form)
  (let ((sb-ext:*evaluator-mode* :interpret))
    (eval form)))

(defmacro same (&rest forms)
  `(dolist (form ',forms)
     (incf *checks*)
     (let ((wanted (outcome #'reference form)) (got (outcome #'clara.compiler:evaluate form)))
       (unless (equal wanted got)
         (failed "compiled, ~S gave ~S, and it means ~S" form got wanted)))))

